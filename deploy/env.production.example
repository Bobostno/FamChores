# Production environment for the Family Hub.
#
#   sudo cp deploy/env.production.example deploy/env.production
#   sudo chmod 600 deploy/env.production
#
# Never commit the real file. Add deploy/env.production to .gitignore locally
# (it is ignored via the `.env*` rule only if named .env*, so this file name is
# matched explicitly below).

# REQUIRED. Signs the session cookies. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Changing this invalidates every existing session, so everyone gets logged out.
# Treat it as permanent — store it in a password manager if you lose the box.
AUTH_SECRET=

# Where the SQLite file lives. Keep it on persistent, backed-up storage; the
# WAL mode means recent writes sit in the -wal file next to it.
DATABASE_PATH=/opt/family-hub/data/family.db

# Leave unset (or 0) on a real deployment. The demo family shares a public
# password, so seeding it in production would expose working accounts.
# Set to 1 only on a throwaway instance you want demo data on.
# SEED_DEMO=0