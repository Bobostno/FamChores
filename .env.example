# Secret used to sign session cookies.
# REQUIRED in production — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional: override where the SQLite file lives.
# DATABASE_PATH=./data/family.db

# Optional: seed the demo family (shared password `demo1234`) into an empty
# database. Defaults to ON in development and OFF in production, so a real
# deployment never exposes those credentials. Set 1 to force on, 0 to force off.
# SEED_DEMO=1